# Copy to .env for local overrides. Never commit .env (it is git-ignored).
REUSERY_HTTP_ADDR=:8080
REUSERY_LOG_LEVEL=info

# PostgreSQL connection string. Required; contains credentials, never log it.
REUSERY_DATABASE_URL=postgres://reusery:reusery@localhost:5432/reusery?sslmode=disable

# Optional bearer token for GitHub's public API. Only raises rate limits for
# `reusery discover`; public unauthenticated discovery works without it.
# Never logged, never part of readiness, never persisted.
REUSERY_GITHUB_TOKEN=

# Optional OpenAI API key. Required ONLY by the model-backed intent commands
# (`reusery normalize`, `reusery normalize-eval`). serve, seed, discover,
# resolve and resolution keep working with no key at all.
# Never logged, never persisted, never included in an error.
REUSERY_OPENAI_API_KEY=

# Optional model override for intent normalisation. Defaults to gpt-6-luna.
# The configured model must be available on your OpenAI account; if it is not,
# the provider returns model_not_found and you should set this explicitly.
REUSERY_OPENAI_MODEL=gpt-6-luna

# HTTP API external operations switch. FALSE by default.
# Only affects the HTTP API: POST /v1/normalize, POST /v1/discover and
# POST /v1/enrich answer 503 (code external_operations_disabled) while false.
# It does NOT disable the equivalent CLI commands (normalize, discover,
# enrich), which keep working either way. resolve, refine, inspection,
# /health and /ready are always available. Readiness never depends on it.
# Accepted values: true or false (case-insensitive); anything else is a
# configuration error.
REUSERY_API_ENABLE_EXTERNAL_OPERATIONS=false